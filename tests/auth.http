@endpoint = http://localhost:3000/api/v1

### Register a user
POST {{endpoint}}/auth/register HTTP/1.1
content-type: application/json

{
    "name": "Horuiaf",
    "email": "horuiaf@example.com",
    "password": "difficult password"
}

### Register with bad data (should be 400)
POST {{endpoint}}/auth/register HTTP/1.1
content-type: application/json

{
    "name": "",
    "email": "not-an-email",
    "password": "123"
}

###
# @name login
POST {{endpoint}}/auth/login HTTP/1.1
content-type: application/json

{
    "email": "horuiaf@example.com",
    "password": "difficult password"
}

### Login with wrong password (should be 401)
POST {{endpoint}}/auth/login HTTP/1.1
content-type: application/json

{
    "email": "horuiaf@example.com",
    "password": "wrong password"
}

### Login with a user that doesn't exist (should be 401)
POST {{endpoint}}/auth/login HTTP/1.1
content-type: application/json

{
    "email": "nobody@example.com",
    "password": "difficult password"
}

###
@accessToken = {{login.response.body.token}}

### Who am I (with token)
GET {{endpoint}}/auth/me HTTP/1.1
Authorization: Bearer {{accessToken}}

### Who am I (no token, should be 401)
GET {{endpoint}}/auth/me HTTP/1.1